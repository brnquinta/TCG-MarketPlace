        <!-- ============ ENTIDADE: User ============ -->
        <mxCell id="ent-user" value="&lt;b&gt;User&lt;/b&gt;&lt;hr&gt;&lt;font style='font-size: 11px'&gt;PK clerkId: String&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;email: String (unique)&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;firstName: String&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;lastName: String&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;imageUrl: String&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;createdAt: Date&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;updatedAt: Date&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="120" y="100" width="200" height="200" as="geometry" />
        </mxCell>

        <!-- ============ ENTIDADE: Store ============ -->
        <mxCell id="ent-store" value="&lt;b&gt;Store&lt;/b&gt;&lt;hr&gt;&lt;font style='font-size: 11px'&gt;PK _id: ObjectId&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;FK userId: ObjectId&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;name: String&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;slug: String (unique)&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;logoUrl: String&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;bannerUrl: String&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;description: String&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;location: {city, state}&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;status: enum&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;onboardingStatus: enum&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;rating: {avg, count}&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;stats: {listings, sales, views}&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;contact: {phone, email}&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;paymentInfo: {cpf, cnpj, pix}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;overflow=hidden;" vertex="1" parent="1">
