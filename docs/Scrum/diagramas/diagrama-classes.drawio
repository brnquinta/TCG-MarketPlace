        <!-- ============ CLASSE USER ============ -->
        <mxCell id="class-user" value="&lt;b&gt;&lt;font style='font-size: 14px'&gt;User&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font style='font-size: 11px'&gt;- clerkId: String&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- email: String&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- firstName: String&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- lastName: String&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- imageUrl: String&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- createdAt: Date&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- updatedAt: Date&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="220" height="200" as="geometry" />
        </mxCell>

        <!-- ============ CLASSE STORE ============ -->
        <mxCell id="class-store" value="&lt;b&gt;&lt;font style='font-size: 14px'&gt;Store&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font style='font-size: 11px'&gt;- userId: ObjectId&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- name: String&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- slug: String (unique)&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- logoUrl: String&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- bannerUrl: String&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- description: String&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- location: {city, state}&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- status: enum&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- onboardingStatus: enum&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- rating: {average, count}&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- stats: {listings, sales, views}&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- contact: {phone, email}&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- paymentInfo: {cpf, cnpj, ...}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="500" y="100" width="240" height="300" as="geometry" />
        </mxCell>

        <!-- ============ CLASSE LISTING ============ -->
        <mxCell id="class-listing" value="&lt;b&gt;&lt;font style='font-size: 14px'&gt;Listing&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font style='font-size: 11px'&gt;- storeId: ObjectId&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- userId: ObjectId&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- cardSnapshot: {&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;&amp;nbsp;&amp;nbsp;cardId, name, number,&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;&amp;nbsp;&amp;nbsp;rarity, image, setId, ...&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;}&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- listingData: {&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;&amp;nbsp;&amp;nbsp;language, condition, price,&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;&amp;nbsp;&amp;nbsp;quantity, certified, grade,&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;&amp;nbsp;&amp;nbsp;shipping, defects, ...&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;}&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- photos: {front90, back90, ...}&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- status: enum&lt;/font&gt;&lt;br&gt;&lt;font style='font-size: 11px'&gt;- views: Number&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="900" y="100" width="240" height="310" as="geometry" />
