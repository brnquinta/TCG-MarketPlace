        <mxCell id="t" value="DIAGRAMA DE CLASSES — TCG Marketplace (Domínio)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1">
