# Servidor
PORT=3001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/tcg-marketplace

# Clerk (Autenticacao)
CLERK_SECRET_KEY=your_clerk_secret_key_here
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret_here

# Mercado Pago (Pagamentos - Sandbox)
MP_ACCESS_TOKEN=your_mp_access_token_here
MP_PUBLIC_KEY=your_mp_public_key_here
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
MP_REDIRECT_URI=http://localhost:3001/api/sellers/mp-callback

# Melhor Envio (Frete - Sandbox)
MELHOR_ENVIO_API_TOKEN=
MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br/api/v2
MELHOR_ENVIO_WEBHOOK_URL=http://localhost:3001/api/webhooks/melhor-envio

# Plataforma
PLATFORM_FEE_PERCENT=10
CONTESTATION_DAYS_REGULAR=7
CONTESTATION_DAYS_CERTIFIED=15
